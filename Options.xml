<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- A few lines of text at the top of a settings page: the game's section header (so the settings
	     list treats it like its own elements), re-styled by ForeverPlatesPlusDescriptionMixin (Options.lua). -->
	<Frame name="ForeverPlatesPlusDescriptionTemplate" inherits="SettingsListSectionHeaderTemplate" mixin="ForeverPlatesPlusDescriptionMixin" virtual="true">
		<Size y="40"/>
	</Frame>
	<!-- The sketch on the appearance page (LookPreview.lua): also a section header underneath, so the
	     settings list handles it like its own elements. -->
	<Frame name="ForeverPlatesPlusPreviewTemplate" inherits="SettingsListSectionHeaderTemplate" mixin="ForeverPlatesPlusPreviewMixin" virtual="true">
		<Size y="196"/>
	</Frame>
</Ui>
